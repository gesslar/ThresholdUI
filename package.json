{
  "name": "thresholdui",
  "version": "4.6.0",
  "description": "The main Threshold Graphical User Interface package for Mudlet",
  "scripts": {
    "build": "npx -y @gesslar/muddy",
    "watch": "npx -y @gesslar/muddy -w",
    "major": "npx -y @gesslar/muddy version major --package && npm i",
    "minor": "npx -y @gesslar/muddy version minor --package && npm i",
    "patch": "npx -y @gesslar/muddy version patch --package && npm i",
    "update": "npx -y npm-check-updates -u && npm install && npm run glu",
    "glu": "npm install @gesslar/glu@latest && cp node_modules/@gesslar/glu/build/Glu-single.lua src/resources/vendor/Glu-single.lua"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gesslar/ThresholdUI.git"
  },
  "author": {
    "name": "gesslar"
  },
  "license": "0BSD",
  "bugs": {
    "url": "https://github.com/gesslar/ThresholdUI/issues"
  },
  "homepage": "https://github.com/gesslar/ThresholdUI#readme",
  "devDependencies": {
    "@gesslar/glu": "^3.1.0"
  }
}
